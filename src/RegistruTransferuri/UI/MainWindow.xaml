<Window x:Class="RegistruTransferuri.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registru Transferuri Media v3.1" Width="1280" Height="800"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}">
            <StatusBarItem><TextBlock x:Name="StatusOperator"/></StatusBarItem>
            <StatusBarItem><TextBlock x:Name="StatusAudit"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="StatusMedia"/></StatusBarItem>
        </StatusBar>
        <TabControl>
            <TabItem Header="Inregistrare Transfer">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <Label Content="Nivel clasificare (Art. 41 HG 585/2002)"/>
                        <ComboBox x:Name="ClassificationCombo" Height="30" Margin="0,4,0,8"/>
                        <Label Content="Institutie sursa"/>
                        <TextBox x:Name="SourceInstBox" Height="30" Margin="0,4,0,8"/>
                        <Label Content="Institutie destinatie"/>
                        <TextBox x:Name="DestInstBox" Height="30" Margin="0,4,0,8"/>
                        <Label Content="Persoana predatoare"/>
                        <TextBox x:Name="SourcePersonBox" Height="30" Margin="0,4,0,8"/>
                        <Label Content="Persoana primitor"/>
                        <TextBox x:Name="DestPersonBox" Height="30" Margin="0,4,0,8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Label Content="Mediu detectat (WMI — serie hardware reala)"/>
                        <ComboBox x:Name="DetectedMediaCombo" Height="30" Margin="0,4,0,4"/>
                        <Button Content="Reimprospatare detectie USB" Click="OnRefreshMedia"
                                Height="30" Margin="0,0,0,8"/>
                        <Label Content="Descriere continut"/>
                        <TextBox x:Name="ContentBox" Height="80" TextWrapping="Wrap"
                                 AcceptsReturn="True" Margin="0,4,0,8"/>
                        <Button Content="Inregistreaza Transfer" Click="OnRegisterTransfer"
                                Height="40" Background="{StaticResource AccentBrush}"
                                Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Registru">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox" Width="320" Height="30"
                                 TextChanged="OnSearchChanged" ToolTip="Cautare: nr. registru, institutie, persoana, serie"/>
                        <ComboBox x:Name="FilterClassCombo" Width="220" Height="30" Margin="8,0"
                                  SelectionChanged="OnSearchChanged"/>
                        <Button Content="Export PDF (PAdES)" Click="OnExportPdf" Height="30" Margin="8,0,0,0"/>
                        <Button Content="Export CSV" Click="OnExportCsv" Height="30" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="RegistryGrid" Grid.Row="1" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionChanged="OnTransferSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr. Registru" Binding="{Binding RegistryNumber}" Width="180"/>
                            <DataGridTextColumn Header="Clasificare" Binding="{Binding Classification}" Width="140"/>
                            <DataGridTextColumn Header="Data UTC" Binding="{Binding TransferDateUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
                            <DataGridTextColumn Header="Sursa" Binding="{Binding SourceInstitution}" Width="*"/>
                            <DataGridTextColumn Header="Destinatie" Binding="{Binding DestinationInstitution}" Width="*"/>
                            <DataGridTextColumn Header="Serie Mediu" Binding="{Binding MediaSerialNumber}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="Semneaza (PIN)" Click="OnSignTransfer" Height="32" Margin="0,0,8,0"/>
                        <Button Content="Anuleaza (cu justificare)" Click="OnCancelTransfer" Height="32"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Inventar Medii">
                <Grid Margin="16">
                    <DataGrid x:Name="MediaGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Serie" Binding="{Binding SerialNumber}" Width="160"/>
                            <DataGridTextColumn Header="Cod Inventar" Binding="{Binding InventoryCode}" Width="120"/>
                            <DataGridTextColumn Header="Tip" Binding="{Binding MediaType}" Width="90"/>
                            <DataGridTextColumn Header="Clasificare Max." Binding="{Binding MaxClassificationHandled}" Width="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                            <DataGridTextColumn Header="Locatie" Binding="{Binding PhysicalLocation}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Audit">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="Verifica Lant Audit" Click="OnVerifyChain" Height="32"/>
                        <Button Content="Calculeaza Radacina Merkle (azi)" Click="OnMerkleRoot" Height="32" Margin="8,0,0,0"/>
                        <TextBlock x:Name="AuditResult" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="AuditGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Secv." Binding="{Binding Sequence}" Width="70"/>
                            <DataGridTextColumn Header="Timestamp UTC" Binding="{Binding TimestampUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170"/>
                            <DataGridTextColumn Header="Actiune" Binding="{Binding Action}" Width="160"/>
                            <DataGridTextColumn Header="Operator" Binding="{Binding OperatorUsername}" Width="130"/>
                            <DataGridTextColumn Header="Detalii" Binding="{Binding Details}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
