<Window x:Class="RegistruTransferuri.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROMÂNIA — REGISTRU MILITAR DE TRANSFERURI &amp; DEVICE CONTROL (HG 585 / NATO AC/35 / EUCI)"
        Width="1440" Height="900"
        MinWidth="1200" MinHeight="750"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg.Deep}"
        Foreground="{StaticResource Brush.Text.Primary}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Bg.Base}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Row="0" Margin="0,4,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource Brush.Bg.Elevated}" BorderBrush="{StaticResource Brush.Accent.Violet}" BorderThickness="1" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                            <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="INFOSEC • MApN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Violet}" />
                            <TextBlock Text="Registru Militar" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                        </StackPanel>
                    </StackPanel>
                    <Separator Background="{StaticResource Brush.Border.Default}" Margin="0,16,0,0" />
                </StackPanel>

                <!-- Navigation RadioButtons -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavRegistru" Content="📋  Registru Transferuri" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="True" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavInregistrare" Content="➕  Înregistrare Transfer" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavMedii" Content="🛡️  Medii Amprentate (PnP)" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavOracle" Content="🧠  Seif Cognitiv &amp; Oracol" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavStats" Content="📊  Statistici &amp; Conformitate" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavAudit" Content="📜  Jurnal Audit SHA-256" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavAdmin" Content="⚙️  Gestiune Operatori" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                </StackPanel>

                <!-- Bottom Sidebar Station Badge -->
                <Border Grid.Row="2" Background="{StaticResource Brush.Bg.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Accent.Emerald}" Margin="0,0,6,0" />
                            <TextBlock Text="REGIM AIR-GAPPED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Emerald}" />
                        </StackPanel>
                        <TextBlock x:Name="LblHostInfo" Text="Stație: HOST-LOCAL" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT AREA ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource Brush.Bg.Base}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- View Title -->
                    <TextBlock x:Name="LblViewTitle" Text="📋 Evidența Transferurilor de Date Clasificate (HG 585 / NATO AC/35)" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />

                    <!-- User Profile & Security Badge -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource Brush.Bg.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤 " FontSize="12" />
                                <TextBlock x:Name="LblOperatorName" Text="Operator" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,0,6,0" />
                                <Border Background="#3B2677" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="LblOperatorClearance" Text="SECRET" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Violet}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Button Content="🔒 Delogare" Height="32" Padding="10,0" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnLogoutClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Views Container -->
            <Grid Grid.Row="1" Margin="20">

                <!-- 1. VIEW REGISTRU -->
                <Grid x:Name="ViewRegistru" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Border Grid.Row="0" Background="{StaticResource Brush.Bg.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtSearchRegistry" Style="{StaticResource TacticalTextBoxStyle}" Height="34" ToolTip="Caută după Nr. Înregistrare, Sursă, Destinație, Persoană, S/N..." TextChanged="OnRegistryFilterChanged" />
                            <ComboBox x:Name="CmbFilterClassification" Grid.Column="1" Height="34" Margin="10,0,0,0" SelectionChanged="OnRegistryFilterChanged" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="📄 Proces-Verbal Predare-Primire" Height="34" Margin="0,0,8,0" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnGenerateProcesVerbalClick" />
                                <Button Content="🔍 Verifică Pachet Recepție" Height="34" Margin="0,0,8,0" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnVerifyReceiverPackageClick" />
                                <Button Content="📤 Export CSV" Height="34" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnExportCsvClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Registry DataGrid -->
                    <DataGrid x:Name="GridTransfers" Grid.Row="1" Style="{StaticResource TacticalDataGridStyle}" SelectionChanged="OnTransferSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr. Înregistrare" Binding="{Binding RegistryNumber}" Width="160" FontWeight="Bold" />
                            <DataGridTextColumn Header="Clasificare Națională" Binding="{Binding Classification}" Width="140" />
                            <DataGridTextColumn Header="Echivalent NATO" Binding="{Binding NatoClassification}" Width="150" />
                            <DataGridTextColumn Header="Dată UTC" Binding="{Binding TransferDateUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="130" />
                            <DataGridTextColumn Header="Sursă" Binding="{Binding SourceInstitution}" Width="*" />
                            <DataGridTextColumn Header="Destinație" Binding="{Binding DestinationInstitution}" Width="*" />
                            <DataGridTextColumn Header="Fișier / Pachet" Binding="{Binding PayloadFileName}" Width="140" />
                            <DataGridTextColumn Header="Mediu &amp; S/N" Binding="{Binding MediaSerialNumber}" Width="140" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Inspector Panel -->
                    <GroupBox Grid.Row="2" Header="📋 Inspector Detalii Transfer Militar &amp; Integritate SHA-256" Style="{StaticResource TacticalGroupBoxStyle}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtInspector" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Cascadia Code" FontSize="11" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Button Content="✍️ Semnează Formal Transfer" Width="200" Height="34" Margin="0,0,0,8" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnSignTransferClick" />
                                <Button Content="🚫 Anulează Transfer" Width="200" Height="34" Style="{StaticResource TacticalDangerButtonStyle}" Click="OnCancelTransferClick" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- 2. VIEW ÎNREGISTRARE TRANSFER NOU -->
                <Grid x:Name="ViewInregistrare" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Header Info -->
                            <Border Background="{StaticResource Brush.Bg.Elevated}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <TextBlock Text="🔒 Datele generate de sistemul de operare despre mediul fizic sunt citite automat și sunt IMUTABILE. Numărul de înregistrare poate fi introdus manual (ex: 2150-23SSv), detectat din fișier sau auto-generat conform HG 585."
                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.Text.Cyan}" />
                            </Border>

                            <!-- Secțiunea 0: Număr Înregistrare & Mediu -->
                            <GroupBox Header="0. Număr Înregistrare &amp; Suport Fizic de Stocare" Style="{StaticResource TacticalGroupBoxStyle}">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Număr Înregistrare Transfer (Manual / Parsat / Auto HG 585): *" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtRegNumber" Style="{StaticResource TacticalTextBoxStyle}" Height="34" Text="MAPN-2026-S-0001" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Mediu Fizic Conectat Detectat Live (USB / SATA / CD-DVD): *" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CmbDetectedMedia" Height="34" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- Secțiunea 1: Entități și Flux -->
                            <GroupBox Header="1. Flux &amp; Entități (Sursă / Destinație / Curier)" Style="{StaticResource TacticalGroupBoxStyle}">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="Unitate Sursă (Expeditor): *" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtSrcInst" Text="MApN / Structura Securitate" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                        <TextBlock Text="Unitate Destinație (Destinatar): *" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtDstInst" Text="Statul Major al Apărării / Baza 2" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="Persoană Responsabilă Sursă: *" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtSrcPerson" Text="Cpt. Ionescu Radu" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                        <TextBlock Text="Persoană Destinatar: *" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtDstPerson" Text="Mr. Popa Mihai" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Curier Militar / Delegat Transport:" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtCourierName" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Permis Transport Curier:" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtCourierPermit" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- Secțiunea 2: Pachet Date & Clasificare -->
                            <GroupBox Header="2. Pachet Date, Clasificare &amp; Integritate Criptografică" Style="{StaticResource TacticalGroupBoxStyle}">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="Nivel Clasificare (HG 585 / NATO / UE): *" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CmbNewTxClass" Height="34" SelectionChanged="OnNewTxClassificationChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                        <TextBlock Text="Selectare Fișier Fizic (Calculare Instantanee Hash SHA-256):" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtPayloadPath" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" Height="34" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="📁 Selectează" Width="100" Height="34" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnSelectPayloadFileClick" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="Denumire Pachet / Arhivă:" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPayloadFileName" Text="Pachet_Date_Securizat.zip" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                        <TextBlock Text="Hash SHA-256 Calculat (Imuabil): 🔒" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPayloadHash" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" Height="34" FontFamily="Consolas, Cascadia Code" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                        <TextBlock Text="Descriere Conținut Pachet &amp; Justificare:" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtContentDesc" Text="Pachet de actualizări și documente operative conform SecOPs." Style="{StaticResource TacticalTextBoxStyle}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- Submit Button -->
                            <Button Content="💾 Înregistrează Transfer în Sistem (cu Verificare 4-Eyes)" Height="44" FontSize="13" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnSubmitTransferClick" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 3. VIEW MEDII AMPRENTATE -->
                <Grid x:Name="ViewMedii" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Card: Live PnP Connected Media -->
                    <GroupBox Grid.Row="0" Header="🔌 Medii Conectate în Timp Real (Live PnP Auto-Detectate: USB, SATA, CD-DVD, SD)" Style="{StaticResource TacticalGroupBoxStyle}">
                        <DataGrid x:Name="GridLiveMedia" Style="{StaticResource TacticalDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Volum" Binding="{Binding DriveLetter}" Width="80" FontWeight="Bold" />
                                <DataGridTextColumn Header="Tip Mediu" Binding="{Binding MediaType}" Width="120" />
                                <DataGridTextColumn Header="Model Fabrică" Binding="{Binding Model}" Width="*" />
                                <DataGridTextColumn Header="Identificator VID:PID" Binding="{Binding VendorId}" Width="140" />
                                <DataGridTextColumn Header="Serie Hardware Firmware (S/N 🔒)" Binding="{Binding SerialNumber}" Width="180" FontFamily="Consolas, Cascadia Code" />
                                <DataGridTextColumn Header="Capacitate" Binding="{Binding CapacityGb, StringFormat={}{0} GB}" Width="100" />
                                <DataGridTemplateColumn Header="Acțiune" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="⚡ Înregistrează / Amprentează" Height="26" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnEnrollDetectedMediaClick" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Bottom Card: Media Whitelist -->
                    <GroupBox Grid.Row="1" Header="📋 Baza de Date a Mediilor de Stocare Amprentate (Device Control Whitelist)" Style="{StaticResource TacticalGroupBoxStyle}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="TxtSearchMedia" Width="300" Height="34" Style="{StaticResource TacticalTextBoxStyle}" ToolTip="Caută după Denumire Volum, Nr. Înregistrare, Serie..." TextChanged="OnMediaFilterChanged" />
                                <Button Content="🏷️ Modifică Denumire Volum / Nr. Înregistrare" Height="34" Margin="10,0,0,0" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnRenameMediaClick" />
                                <Button Content="🧹 Sanitizare NIST SP 800-88r2" Height="34" Margin="10,0,0,0" Style="{StaticResource TacticalDangerButtonStyle}" Click="OnSanitizeMediaClick" />
                            </StackPanel>

                            <DataGrid x:Name="GridMediaWhitelist" Grid.Row="1" Style="{StaticResource TacticalDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Denumire Volum &amp; Nr. Înreg." Binding="{Binding FriendlyName}" Width="200" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Tip Mediu" Binding="{Binding MediaType}" Width="120" />
                                    <DataGridTextColumn Header="Model Fabrică" Binding="{Binding Model}" Width="*" />
                                    <DataGridTextColumn Header="Serie Hardware S/N 🔒" Binding="{Binding SerialNumber}" Width="160" FontFamily="Consolas, Cascadia Code" />
                                    <DataGridTextColumn Header="Capacitate" Binding="{Binding CapacityGb, StringFormat={}{0} GB}" Width="90" />
                                    <DataGridTextColumn Header="Plafon Clasificare" Binding="{Binding MaxClassification}" Width="130" />
                                    <DataGridTextColumn Header="Politică Acces" Binding="{Binding Status}" Width="130" />
                                    <DataGridTextColumn Header="Gestionar" Binding="{Binding CustodianName}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- 4. VIEW SEIF COGNITIV & ORACOL INFOSEC -->
                <Grid x:Name="ViewOracle" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource Brush.Bg.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🧠 Punte Cognitivă AI Memory Vault:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Violet}" />
                                <TextBlock x:Name="LblVaultStatus" Text=" Conectat (c:\Users\Marius\Documents\Codex\AI_Memory_Vault_CODEX_READY)" FontSize="12" Foreground="{StaticResource Brush.Accent.Emerald}" />
                            </StackPanel>
                            <TextBlock Text="Asistent offline de securitate pentru interogarea procedurilor HG 585/2002, NATO AC/35, EUCI 2013/488/UE și NIST SP 800-88r2."
                                       FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </Border>

                    <!-- Oracle Output Card -->
                    <GroupBox Grid.Row="1" Header="📜 Răspuns Oracol Securitate &amp; Sinteză Memorie" Style="{StaticResource TacticalGroupBoxStyle}">
                        <WebBrowser x:Name="BrowserOracle" />
                    </GroupBox>

                    <!-- Oracle Input Bar -->
                    <Border Grid.Row="2" Background="{StaticResource Brush.Bg.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtOracleQuery" Style="{StaticResource TacticalTextBoxStyle}" Height="36" Text="Care sunt normele de sanitizare NIST 800-88r2 pentru medii secrete?" KeyDown="OnOracleQueryKeyDown" />
                            <Button Grid.Column="1" Content="🔍 Întreabă Oracolul" Height="36" Margin="10,0,0,0" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnAskOracleClick" />
                            <Button Grid.Column="2" Content="📥 Sintetizează Transfer în Seif (RAW_IMPORTS)" Height="36" Margin="10,0,0,0" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnSynthesizeTransferClick" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. VIEW STATISTICI -->
                <Grid x:Name="ViewStats" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- KPI 1 -->
                        <Border Grid.Column="0" Background="{StaticResource Brush.Bg.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL TRANSFERURI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" />
                                <TextBlock x:Name="KpiTotalTransfers" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Violet}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- KPI 2 -->
                        <Border Grid.Column="1" Background="{StaticResource Brush.Bg.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,8,0">
                            <StackPanel>
                                <TextBlock Text="SECRET / NATO CONFIDENTIAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" />
                                <TextBlock x:Name="KpiSecretTransfers" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Amber}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- KPI 3 -->
                        <Border Grid.Column="2" Background="{StaticResource Brush.Bg.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,8,0">
                            <StackPanel>
                                <TextBlock Text="MEDII AMPRENTATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" />
                                <TextBlock x:Name="KpiEnrolledMedia" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Emerald}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- KPI 4 -->
                        <Border Grid.Column="3" Background="{StaticResource Brush.Bg.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="VOLUM TOTAL DATE (GB)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" />
                                <TextBlock x:Name="KpiVolumeGb" Text="0.0 GB" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.CyberBlue}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <GroupBox Grid.Row="1" Header="📜 Raport Sintetic de Conformitate INFOSEC &amp; Registru Militar" Style="{StaticResource TacticalGroupBoxStyle}">
                        <TextBox x:Name="TxtStatsReport" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Cascadia Code" FontSize="12" />
                    </GroupBox>
                </Grid>

                <!-- 6. VIEW AUDIT -->
                <Grid x:Name="ViewAudit" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="140" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource Brush.Bg.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔗 Verifică Integritatea Lanțului Criptografic SHA-256" Height="34" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnVerifyAuditChainClick" />
                            <TextBlock x:Name="LblAuditStatus" Text="Lanț audit: Neverificat" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Brush.Accent.Emerald}" />
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="GridAudit" Grid.Row="1" Style="{StaticResource TacticalDataGridStyle}" SelectionChanged="OnAuditSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Secv." Binding="{Binding Sequence}" Width="70" FontWeight="Bold" />
                            <DataGridTextColumn Header="Timestamp UTC" Binding="{Binding TimestampUtc}" Width="160" />
                            <DataGridTextColumn Header="Acțiune" Binding="{Binding Action}" Width="160" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Operator" Binding="{Binding OperatorUsername}" Width="140" />
                            <DataGridTextColumn Header="Detalii Eveniment" Binding="{Binding Details}" Width="*" />
                            <DataGridTextColumn Header="Hash Intrare (SHA-256)" Binding="{Binding EntryHash}" Width="160" FontFamily="Consolas, Cascadia Code" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Header="📋 Inspector Criptografic Bloc Audit (Genesis &amp; Previous Chain Hash)" Style="{StaticResource TacticalGroupBoxStyle}" Margin="0,12,0,0">
                        <TextBox x:Name="TxtAuditInspector" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Cascadia Code" FontSize="11" />
                    </GroupBox>
                </Grid>

                <!-- 7. VIEW ADMIN -->
                <Grid x:Name="ViewAdmin" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="👤 Înregistrare Operator Militar Nou" Style="{StaticResource TacticalGroupBoxStyle}" Margin="0,0,12,0">
                        <StackPanel Margin="4,8,4,4">
                            <TextBlock Text="Nume Complet &amp; Grad: *" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtNewOpName" Style="{StaticResource TacticalTextBoxStyle}" Height="34" Margin="0,0,0,10" />

                            <TextBlock Text="Funcție &amp; Responsabilitate:" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtNewOpRole" Text="Operator Transferuri IT" Style="{StaticResource TacticalTextBoxStyle}" Height="34" Margin="0,0,0,10" />

                            <TextBlock Text="Unitate Militară:" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtNewOpUnit" Text="MApN / Structura Securitate" Style="{StaticResource TacticalTextBoxStyle}" Height="34" Margin="0,0,0,10" />

                            <TextBlock Text="Nivel Autorizare (Clearance HG 585):" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbNewOpClearance" Height="34" Margin="0,0,0,10" />

                            <TextBlock Text="PIN Inițial (6 cifre numerice): *" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="TxtNewOpPin" Style="{StaticResource TacticalPasswordBoxStyle}" Height="34" MaxLength="6" Margin="0,0,0,16" />

                            <Button Content="➕ Înregistrează Operator" Height="38" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnAddNewOperatorClick" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="👥 Operatori Înregistrați în Baza de Date" Style="{StaticResource TacticalGroupBoxStyle}">
                        <DataGrid x:Name="GridOperators" Style="{StaticResource TacticalDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nume Operator" Binding="{Binding FullName}" Width="*" FontWeight="Bold" />
                                <DataGridTextColumn Header="Funcție" Binding="{Binding Role}" Width="140" />
                                <DataGridTextColumn Header="Unitate" Binding="{Binding MilitaryUnit}" Width="160" />
                                <DataGridTextColumn Header="Clearance Maxim" Binding="{Binding MaxClearance}" Width="140" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Active}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
