<Window x:Class="RegistruTransferuri.UI.Dialogs.SanitizationCertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛡️ CERTIFICAT SANITIZARE NIST SP 800-88 REV. 2"
        Height="680" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg.Deep}"
        Foreground="{StaticResource Brush.Text.Primary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WebBrowser x:Name="BrowserPreview" Grid.Row="0" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="💾 Salvează Certificat HTML" Width="190" Height="34" Margin="0,0,10,0" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnSaveClick" />
            <Button Content="Închide" Width="100" Height="34" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
