<Window x:Class="RegistruTransferuri.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AUTENTIFICARE — REGISTRU MILITAR DE TRANSFERURI"
        Height="480" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Bg.Deep}"
        Foreground="{StaticResource Brush.Text.Primary}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo & Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Border Background="{StaticResource Brush.Bg.Elevated}" BorderBrush="{StaticResource Brush.Accent.Violet}" BorderThickness="1" CornerRadius="12" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="🛡️" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="ROMÂNIA • MApN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.CyberBlue}" HorizontalAlignment="Center" />
            <TextBlock Text="Registru Transferuri Date" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
            <TextBlock Text="Sistem Informatic Securizat Air-Gapped" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Form Card -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Bg.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Selectați Operator Militar: *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,6" />
                <ComboBox x:Name="OperatorCombo" Height="38" Margin="0,0,0,16" />

                <TextBlock Text="PIN Numeric de Autentificare (6 cifre): *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,6" />
                <PasswordBox x:Name="PinBox" Height="42" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="6" KeyDown="OnPinKeyDown" />
            </StackPanel>
        </Border>

        <!-- Action Button -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <Button Content="🔓 Autentificare în Sistem" Height="40" FontSize="13" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnLoginClick" />
            <TextBlock x:Name="LblError" Text="" FontSize="11" Foreground="{StaticResource Brush.Accent.Crimson}" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
