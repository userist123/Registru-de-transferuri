<Window x:Class="RegistruTransferuri.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registru Transferuri v3.1 — Autentificare" Width="420" Height="320"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="32">
        <TextBlock Text="REGISTRU TRANSFERURI MEDIA" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <TextBlock Text="v3.1 — HG 585/2002 · eIDAS 2.0 · NIST SP 800-88r2"
                   FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,24" Opacity="0.7"/>
        <Label Content="Utilizator" Target="{Binding ElementName=UsernameBox}"/>
        <TextBox x:Name="UsernameBox" Height="32" Margin="0,4,0,12"/>
        <Label Content="PIN (6 cifre)" Target="{Binding ElementName=PinBox}"/>
        <PasswordBox x:Name="PinBox" Height="32" MaxLength="6" Margin="0,4,0,8"/>
        <TextBlock x:Name="ErrorText" Foreground="#FFDD6974" FontSize="12" Margin="0,4"/>
        <Button Content="Autentificare" Click="OnLoginClick" Height="36" Margin="0,12,0,0"
                Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold"/>
    </StackPanel>
</Window>
